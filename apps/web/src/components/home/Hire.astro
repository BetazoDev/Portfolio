---
// "Need an AI Engineer on your team?": a languages card over a fan of project covers, and a checklist card with the CV.
import { Picture } from "astro:assets";
import Button from "../Button.astro";
import Icon from "../Icon.astro";
import { covers } from "../../lib/images";
import { t, site, type Lang } from "../../lib/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = t.home[lang].hire;
const shots = t.projects[lang].map((p) => p.slug);
---
<section class="hire section" aria-labelledby="hire-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-reveal>{h.eyebrow}</p>
      <h2 id="hire-title" class="h2" data-reveal><span class="l">{h.a}</span> {h.b} <em>{h.em}</em></h2>
      <p class="lead" data-reveal>{h.lead}</p>
    </div>
    <div class="cards">
      <div class="card left" data-reveal>
        <p class="big">{h.big}</p>
        <p class="bl">{h.bigLabel}</p>
        <div class="fan" aria-hidden="true">
          {[...shots, ...shots.slice(0, 3)].map((slug, i) => (
            <span class="shot" style={`--i:${i}`}><Picture src={covers[slug]} alt="" widths={[360]} sizes="200px" formats={["avif", "webp"]} loading="lazy" /></span>
          ))}
        </div>
      </div>
      <div class="card right" data-reveal data-reveal-delay="0.08">
        <h3 class="h3">{h.title}</h3>
        <hr />
        <ul class="checks">{h.list.map((x) => <li><Icon name="check-circle-fill" />{x}</li>)}</ul>
        <div class="btns">
          <Button href={site.cv[lang].pdf} label={h.cv} variant="accent" icon="download-simple" download />
          <Button href={`mailto:${site.email}`} label={h.email} variant="ghost" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: 20px; justify-items: center; text-align: center; margin-bottom: clamp(48px, 6vw, 80px); }
  .head .lead { text-align: center; }
  .l { display: block; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 1040px; margin-inline: auto; }
  .card { position: relative; overflow: hidden; padding: clamp(26px, 3vw, 40px); min-height: 520px; display: flex; flex-direction: column; }
  .big { font-size: clamp(3.4rem, 6vw, 5.4rem); line-height: 1; letter-spacing: -0.05em; color: #fff; }
  .bl { margin-top: 16px; color: var(--muted); font-size: 1.12rem; max-width: 24ch; }
  .fan { position: absolute; left: -6%; right: -30%; bottom: -16%; height: 62%; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; transform: rotate(-12deg); transform-origin: left bottom; }
  .shot { display: block; border-radius: 12px; overflow: hidden; border: 1px solid var(--line-2); aspect-ratio: 16 / 10.5; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.8); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .shot:nth-child(4n + 2), .shot:nth-child(4n + 4) { transform: translateY(-22%); }
  .left::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, var(--card) 34%, transparent 60%); pointer-events: none; }
  .left > p { position: relative; z-index: 1; }
  .right { gap: 0; }
  hr { margin: 28px 0; border: 0; border-top: 1px dashed var(--line-2); }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .checks li { display: flex; align-items: flex-start; gap: 12px; font-size: 1.06rem; }
  .checks :global(.icon) { font-size: 22px; color: #fff; flex: none; margin-top: 1px; }
  .btns { margin-top: auto; padding-top: 36px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; }
  @media (max-width: 860px) {
    .cards { grid-template-columns: 1fr; }
    .card { min-height: 0; }
    .left { min-height: 420px; }
  }
</style>
