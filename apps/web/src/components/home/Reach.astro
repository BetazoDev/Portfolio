---
// "Building with LLMs? Let's get in touch.": a crimson band with a grid and grain, and a big round button
// that leans toward the pointer (site.ts → magnetic).
import Roll from "../Roll.astro";
import { t, href, type Lang } from "../../lib/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const r = t.home[lang].reach;
---
<section class="reach grain" aria-labelledby="reach-title">
  <div class="bg" aria-hidden="true"></div>
  <div class="wrap row">
    <div class="copy">
      <h2 id="reach-title" class="h2" data-reveal><span class="l">{r.a}</span><span class="l">{r.b} <em>{r.em}</em></span></h2>
      <p data-reveal>{r.text}</p>
    </div>
    <a class="circle" href={href(lang, "/contact/")} data-magnetic data-reveal aria-label={r.circle}><span class="fill" aria-hidden="true"></span><span class="lbl"><Roll text={r.circle} /></span></a>
  </div>
</section>

<style>
  .reach { position: relative; overflow: hidden; isolation: isolate; padding-block: clamp(80px, 9vw, 128px); }
  .bg { position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse 60% 110% at 0% 70%, #ff2a55 0%, var(--accent) 28%, rgba(206, 0, 55, 0.45) 52%, transparent 75%),
      radial-gradient(ellipse 40% 80% at 100% 100%, rgba(206, 0, 55, 0.22), transparent 70%); }
  .bg::after { content: ""; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.09) 1px, transparent 1px);
    background-size: 72px 72px; -webkit-mask-image: linear-gradient(90deg, #000 10%, transparent 62%); mask-image: linear-gradient(90deg, #000 10%, transparent 62%); }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 40px; }
  .copy { display: grid; gap: 24px; }
  .h2 { color: #fff; }
  .l { display: block; }
  .copy p { color: rgba(255, 255, 255, 0.86); max-width: 42ch; }
  .circle { position: relative; flex: none; width: clamp(170px, 17vw, 228px); aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.55); display: grid; place-items: center; text-decoration: none; color: #fff; font-size: 1.1rem; overflow: hidden; isolation: isolate; }
  .fill { position: absolute; inset: 0; border-radius: 50%; background: var(--accent); transform: scale(0); transition: transform 0.6s var(--ease); z-index: -1; }
  .circle:hover .fill { transform: scale(1); }
  .circle:hover { border-color: var(--accent); }
  @media (max-width: 760px) {
    .row { flex-direction: column; align-items: flex-start; }
    .circle { width: 160px; }
  }
</style>
