---
// "Selected work": one project at a time, cover on the left, story on the right, arrows to move.
// site.ts → slider() animates the change and moves the view-transition names to the visible slide,
// so opening a case study still morphs its cover and title. Without JS the first project shows
// and the "All work" link leads to the rest.
import { Picture } from "astro:assets";
import Icon from "../Icon.astro";
import Roll from "../Roll.astro";
import { covers } from "../../lib/images";
import { t, href, type Lang } from "../../lib/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t.home[lang].slider;
const projects = t.projects[lang];
const view = t.home[lang].view;
const total = String(projects.length).padStart(2, "0");
const first = projects[0];
---
<section id="work" class="work section" aria-labelledby="work-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-reveal>{s.eyebrow}</p>
      <h2 id="work-title" class="h2" data-reveal>{s.a} <em>{s.em}</em></h2>
      <p class="lead" data-reveal>{t.home[lang].workIntro}</p>
    </div>
    <div class="slider" data-slider data-reveal aria-roledescription="carousel" aria-label={s.eyebrow}>
      <div class="stage">
        {projects.map((p, i) => (
          <a class:list={["slide", { on: i === 0 }]} href={href(lang, `/work/${p.slug}/`)} data-slide={i} data-slug={p.slug}
             aria-hidden={i ? "true" : undefined} tabindex={i ? -1 : undefined}
             style={i === 0 ? `view-transition-name: cover-${p.slug}` : undefined}>
            <Picture src={covers[p.slug]} alt={p.name} widths={[600, 900, 1200]} sizes="(max-width: 900px) 92vw, 720px" formats={["avif", "webp"]} loading={i === 0 ? "lazy" : "lazy"} />
          </a>
        ))}
      </div>
      <div class="side">
        <div class="infos">
          {projects.map((p, i) => (
            <div class:list={["info", { on: i === 0 }]} data-info={i} aria-hidden={i ? "true" : undefined} inert={i ? true : undefined}>
              <p class="meta-mono">{String(i + 1).padStart(2, "0")} / {p.year}</p>
              <h3 class="title" style={i === 0 ? `view-transition-name: title-${p.slug}` : undefined}>{p.name}</h3>
              <p class="tagline">{p.tagline}</p>
              <dl class="facts">
                <div><dt>{s.role}</dt><dd>{p.role}</dd></div>
                <div><dt>{s.stack}</dt><dd>{p.tags.slice(0, 2).join(", ")}</dd></div>
              </dl>
            </div>
          ))}
        </div>
        <div class="controls">
          <button class="round arrow" type="button" data-prev aria-label={s.prev}><Icon name="arrow-left" /></button>
          <button class="round arrow" type="button" data-next aria-label={s.next}><Icon name="arrow-right" /></button>
          <p class="count meta-mono" aria-live="polite"><span data-count>01</span> / {total}</p>
          <a class="view" href={href(lang, `/work/${first.slug}/`)} data-view-link aria-label={`${view}: ${first.name}`}><Roll text={view} /><Icon name="arrow-up-right" /></a>
        </div>
      </div>
    </div>
    <div class="all" data-reveal><a class="btn btn-line" href={href(lang, "/work/")} aria-label={s.all}><Roll text={s.all} /><Icon name="arrow-right" /></a></div>
  </div>
</section>

<style>
  .head { display: grid; gap: 20px; justify-items: center; text-align: center; margin-bottom: clamp(48px, 6vw, 88px); }
  .head .lead { text-align: center; }
  .slider { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .stage { position: relative; aspect-ratio: 16 / 11; border-radius: var(--radius); }
  .stage::before { content: ""; position: absolute; inset: -14% -10%; z-index: -1; background: radial-gradient(closest-side, rgba(206, 0, 55, 0.4), transparent); filter: blur(30px); pointer-events: none; }
  .slide { position: absolute; inset: 0; display: block; border-radius: var(--radius); overflow: hidden; background: var(--dark); border: 1px solid var(--line-2); visibility: hidden; }
  .slide.on { visibility: visible; }
  .slide :global(picture), .slide :global(img) { display: block; width: 100%; height: 100%; }
  .slide :global(img) { object-fit: cover; transition: transform 1.2s var(--ease); }
  .slide:hover :global(img) { transform: scale(1.035); }
  .side { display: grid; gap: 40px; }
  .infos { display: grid; }
  .info { grid-area: 1 / 1; display: grid; gap: 18px; align-content: start; visibility: hidden; }
  .info.on { visibility: visible; }
  .title { font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.06; letter-spacing: -0.04em; width: fit-content; }
  .tagline { color: var(--muted); font-size: 1.08rem; max-width: 40ch; }
  .facts { margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 18px 40px; }
  .facts dt { color: var(--faint); font-size: 0.92rem; }
  .facts dd { margin: 4px 0 0; color: var(--ink); }
  .controls { display: flex; align-items: center; gap: 12px; }
  .arrow { cursor: pointer; }
  .arrow:hover { background: #fff; color: #0b0a0a; border-color: #fff; }
  .count { margin-left: 8px; }
  .view { margin-left: auto; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 1.02rem; }
  .view :global(svg) { width: 18px; height: 18px; transition: transform 0.4s var(--ease); }
  .view:hover :global(svg) { transform: translate(2px, -2px); }
  .all { margin-top: clamp(48px, 6vw, 72px); display: flex; justify-content: center; }
  @media (max-width: 900px) {
    .slider { grid-template-columns: 1fr; }
    .side { gap: 28px; }
  }
  @media (max-width: 520px) {
    .controls { flex-wrap: wrap; }
    .view { margin-left: 0; width: 100%; justify-content: space-between; padding-top: 14px; border-top: 1px solid var(--line); }
  }
</style>
