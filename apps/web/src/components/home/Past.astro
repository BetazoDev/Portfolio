---
// Experience: the four most recent roles in a two-by-two grid split by hairlines.
import Button from "../Button.astro";
import { t, site, type Lang } from "../../lib/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t.home[lang].past;
const roles = t.about[lang].experience.slice(0, 4);
---
<section class="past section" aria-labelledby="past-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-reveal>{p.eyebrow}</p>
      <h2 id="past-title" class="h2" data-reveal><span class="l">{p.a}</span> <em>{p.em}</em></h2>
      <p class="lead" data-reveal>{p.lead}</p>
    </div>
    <ol class="grid">
      {roles.map((r, i) => (
        <li data-reveal data-reveal-delay={String((i % 2) * 0.08)}>
          <div class="top"><h3>{r.org}</h3><p class="dates">{r.dates}</p></div>
          <p class="role">{r.role}</p>
          <p class="txt">{r.text}</p>
        </li>
      ))}
    </ol>
    <div class="cv" data-reveal><Button href={site.cv[lang].pdf} label={p.cv} variant="ghost" icon="download-simple" download /></div>
  </div>
</section>

<style>
  .head { display: grid; gap: 20px; justify-items: center; text-align: center; margin-bottom: clamp(48px, 6vw, 88px); }
  .head .lead { text-align: center; }
  .l { display: block; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid li { padding: 34px clamp(24px, 4vw, 60px) 38px 0; display: grid; gap: 8px; align-content: start; }
  .grid li:nth-child(even) { padding: 34px 0 38px clamp(24px, 4vw, 60px); border-left: 1px solid var(--line); }
  .grid li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  h3 { font-size: clamp(1.5rem, 2.3vw, 2rem); letter-spacing: -0.035em; line-height: 1.15; }
  .dates { font: 400 var(--mono-xs)/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .role { color: var(--ink-2); }
  .txt { margin-top: 12px; color: var(--muted); max-width: 46ch; }
  .cv { margin-top: 40px; display: flex; justify-content: center; }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .grid li, .grid li:nth-child(even) { padding: 28px 0; border-left: 0; }
    .grid li + li { border-top: 1px solid var(--line); }
    .top { flex-direction: column; gap: 6px; }
  }
</style>
