---
// Home opening: name and role on the left, the cut-out portrait on the right over a slow crimson flame.
// site.ts → hero() raises the lines out of their masks, fades the rest in and brings up the portrait.
import { Picture } from "astro:assets";
import Button from "../Button.astro";
import meCut from "../../assets/me-cut.webp";
import { t, site, type Lang } from "../../lib/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t.home[lang];
const h = c.hero;
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="glow" aria-hidden="true" data-glow>
    <svg class="flame a" viewBox="0 0 1440 900" preserveAspectRatio="none"><path d="M-160 780 C 180 650 380 900 680 600 S 960 150 1130 420 S 1390 780 1620 640" /></svg>
    <svg class="flame b" viewBox="0 0 1440 900" preserveAspectRatio="none"><path d="M-160 700 C 160 560 420 820 700 520 S 930 230 1100 470 S 1360 700 1620 560" /></svg>
  </div>
  <div class="wrap copy">
    <p class="eyebrow" data-fade>{h.eyebrow}</p>
    <h1 id="hero-title" class="display">
      {h.lines.map((l) => <span class="mask"><span class="line" data-rise>{l}</span></span>)}
      <span class="mask"><em class="line" data-rise>{h.em}</em></span>
    </h1>
    <p class="intro" data-fade>{h.intro}</p>
    <div class="actions" data-fade>
      <Button href={site.cv[lang].pdf} label={h.cv} variant="light" icon="download-simple" download />
      <Button href="#work" label={h.work} variant="ghost" icon="arrow-down-right" />
    </div>
    <p class="status" data-fade><span class="pulse" aria-hidden="true"></span>{h.status}<span class="sep" aria-hidden="true">/</span>{h.place}</p>
  </div>
  <div class="pwrap" data-portrait>
    <span class="halo" aria-hidden="true"></span>
    <figure class="portrait">
      <Picture src={meCut} alt={site.name} widths={[480, 720, 960, 1200, 1400]} sizes="(max-width: 1000px) 78vw, 580px" formats={["avif", "webp"]} fallbackFormat="webp" loading="eager" fetchpriority="high" />
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; margin-top: calc(-1 * var(--hdr)); min-height: max(720px, 100svh); display: grid; align-items: center; padding-block: calc(var(--hdr) + 48px) 96px; overflow: hidden; isolation: isolate; }

  /* Flame: two blurred ribbons that drift on their own clocks (transform only, so the blur is rasterized once) */
  .glow { position: absolute; inset: 0; z-index: -1; pointer-events: none; -webkit-mask-image: linear-gradient(#000 55%, transparent 96%); mask-image: linear-gradient(#000 55%, transparent 96%); }
  .flame { position: absolute; inset: -10% -5%; width: 110%; height: 120%; overflow: visible; will-change: transform; }
  .flame path { fill: none; stroke-linecap: round; }
  .flame.a { filter: blur(70px); opacity: 0.66; }
  .flame.a path { stroke: var(--accent); stroke-width: 160; }
  .flame.b { filter: blur(38px); opacity: 0.55; mix-blend-mode: screen; }
  .flame.b path { stroke: var(--accent-glow); stroke-width: 54; }
  @media (prefers-reduced-motion: no-preference) {
    .flame.a { animation: drift-a 16s ease-in-out infinite alternate; }
    .flame.b { animation: drift-b 11s ease-in-out infinite alternate; }
  }
  @keyframes drift-a { from { transform: translate3d(-2%, 1%, 0) rotate(-1.5deg) scale(1); } to { transform: translate3d(3%, -3%, 0) rotate(2deg) scale(1.06); } }
  @keyframes drift-b { from { transform: translate3d(2%, 2%, 0) rotate(1deg); } to { transform: translate3d(-3%, -4%, 0) rotate(-2.5deg); } }

  .copy { position: relative; z-index: 2; display: grid; justify-items: start; }
  .eyebrow { margin-bottom: 26px; }
  .display { font-size: clamp(2.6rem, 4.7vw, 4.6rem); line-height: 1.1; max-width: none; }
  .mask { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .line { display: block; }
  .intro { margin-top: 30px; max-width: 46ch; font-size: clamp(1.04rem, 1.3vw, 1.16rem); color: var(--ink-2); line-height: 1.6; }
  .actions { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  .status { margin-top: 40px; display: inline-flex; align-items: center; flex-wrap: wrap; gap: 10px; font: 400 var(--mono-xs)/1.5 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .sep { color: var(--faint); }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6); }
  @media (prefers-reduced-motion: no-preference) { .pulse { animation: pulse 2.4s ease-out infinite; } }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(61, 220, 132, 0); } 100% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0); } }

  /* Portrait: tall cut-out (head to crossed hands), bottom-aligned, the hands fading into the dark */
  .pwrap { position: absolute; z-index: 1; bottom: 0; right: max(0px, calc(50vw - 660px)); height: min(820px, 90svh, 72vw); aspect-ratio: 1400 / 1982; }
  .halo { position: absolute; left: 6%; right: 6%; top: 2%; height: 58%; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 42, 85, 0.5), rgba(206, 0, 55, 0.22) 55%, transparent); filter: blur(30px); }
  .portrait { position: relative; margin: 0; width: 100%; height: 100%; -webkit-mask-image: linear-gradient(#000 76%, transparent 99%); mask-image: linear-gradient(#000 76%, transparent 99%); }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: contain; object-position: bottom; filter: grayscale(1) contrast(1.06) brightness(1.02); }

  /* Initial states for the intro (only with JS and motion) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-rise] { transform: translateY(110%); }
    :global(.js) [data-fade] { opacity: 0; }
    :global(.js) [data-portrait] { opacity: 0; }
    :global(.js) [data-glow] { opacity: 0; }
  }

  @media (max-width: 1000px) {
    .hero { min-height: 0; padding-bottom: 0; align-items: start; }
    .pwrap { position: relative; right: auto; bottom: auto; height: auto; width: min(78vw, 440px); margin: 40px auto 0; }
    .flame { inset: 10% -30% -10%; width: 160%; height: 100%; }
    .flame.a { opacity: 0.5; }
    .flame.b { opacity: 0.4; }
  }
  @media (max-width: 520px) {
    .actions { gap: 6px 18px; }
    .status { font-size: 12px; }
  }
</style>
