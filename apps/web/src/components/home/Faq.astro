---
// FAQ for recruiters: native <details> with a shared name (one open at a time), height animated in CSS.
import { t, type Lang } from "../../lib/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const f = t.home[lang].faq;
---
<section class="faq section" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-reveal>{f.eyebrow}</p>
      <h2 id="faq-title" class="h2" data-reveal>{f.a} <em>{f.em}</em></h2>
      <p class="lead" data-reveal>{f.lead}</p>
    </div>
    <div class="list">
      {f.items.map((it, i) => (
        <details class="card q" name="faq" open={i === 0} data-reveal>
          <summary><span class="qt">{it.q}</span><span class="pm" aria-hidden="true"></span></summary>
          <p class="a">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: 20px; justify-items: center; text-align: center; margin-bottom: clamp(44px, 5vw, 72px); }
  .head .lead { text-align: center; }
  .list { max-width: 960px; margin-inline: auto; display: grid; gap: 14px; }
  .q { border-radius: 20px; transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease); }
  .q[open] { border-color: var(--line-2); }
  summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px clamp(20px, 2.4vw, 28px); cursor: pointer; font-size: clamp(1.08rem, 1.6vw, 1.32rem); letter-spacing: -0.02em; }
  summary::-webkit-details-marker { display: none; }
  .pm { position: relative; flex: none; width: 38px; height: 38px; border-radius: 50%; background: var(--paper-2); border: 1px solid var(--line); transition: background-color 0.3s var(--ease), transform 0.5s var(--ease); }
  .pm::before, .pm::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; margin: -0.75px 0 0 -6px; background: currentColor; border-radius: 2px; transition: transform 0.4s var(--ease); }
  .pm::after { transform: rotate(90deg); }
  .q[open] .pm { background: var(--accent); border-color: var(--accent); transform: rotate(180deg); }
  .q[open] .pm::after { transform: rotate(0deg); }
  summary:hover .pm { border-color: var(--line-2); }
  .a { padding: 0 clamp(20px, 2.4vw, 28px) 26px; color: var(--muted); max-width: 70ch; visibility: hidden; transition: visibility 0s 0.5s; }
  .q[open] .a { visibility: visible; transition-delay: 0s; }
  .q::details-content { block-size: 0; overflow: clip; transition: block-size 0.5s var(--ease), content-visibility 0.5s allow-discrete; }
  .q[open]::details-content { block-size: auto; }
  @media (prefers-reduced-motion: reduce) { .q::details-content { transition: none; } }
</style>
