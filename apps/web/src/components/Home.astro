---
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Numbers from "./Numbers.astro";
import Flagship from "./Flagship.astro";
import Work from "./Work.astro";
import Approach from "./Approach.astro";
import Stack from "./Stack.astro";
import Experience from "./Experience.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { t, type Lang } from "../lib/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
---
<Base lang={lang} title={c.meta.title} description={c.meta.description} path="/">
  <Nav lang={lang} alt={lang === "es" ? "/" : "/es/"} />
  <main id="main">
    <Hero lang={lang} />
    <Numbers lang={lang} />
    <Flagship lang={lang} />
    <Work lang={lang} />
    <Approach lang={lang} />
    <Stack lang={lang} />
    <Experience lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
