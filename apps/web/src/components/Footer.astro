---
// Footer over a slow crimson smoke: the invitation and the email on the left, a numbered menu on the right.
import Icon from "./Icon.astro";
import Roll from "./Roll.astro";
import { t, href, site, type Lang } from "../lib/content";
interface Props { lang: Lang; alt: string; contact?: boolean }
const { lang, alt, contact = true } = Astro.props;
const c = t.ui[lang];
const e = t.home[lang].end;
const nav = [
  { label: e.home, url: href(lang, "/") },
  { label: c.nav.work, url: href(lang, "/work/") },
  { label: c.nav.about, url: href(lang, "/about/") },
  { label: c.nav.contact, url: href(lang, "/contact/") },
  { label: c.nav.cv, url: site.cv[lang].pdf, download: true },
];
---
<footer class="ftr grain">
  <div class="smoke" aria-hidden="true"><span class="s1"></span><span class="s2"></span><span class="s3"></span></div>
  <div class="wrap top">
    <div class="who">
      <p class="brand"><em>Humberto</em> Alonso</p>
      {contact ? (
        <>
          <h2 class="big">{e.a} <em>{e.em}</em></h2>
          <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        </>
      ) : (
        <p class="tag-line">{c.footer.tagline}</p>
      )}
    </div>
    <nav class="menu" aria-label={c.footer.site}>
      {nav.map((n, i) => (
        <a href={n.url} download={n.download ? "" : undefined} data-astro-reload={n.download ? "" : undefined} aria-label={n.label}>
          <Icon name={n.download ? "download-simple" : "arrow-right"} /><Roll text={n.label} /><span class="n" aria-hidden="true">0{i + 1}</span>
        </a>
      ))}
    </nav>
  </div>
  <div class="wrap bottom">
    <p>{e.made}<br />© 2026 Humberto Alonso López <span aria-hidden="true">/</span> <a href={alt}>{c.footer.lang}</a></p>
    <div class="social">
      <a class="round" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin-logo" /></a>
      <a class="round" href={site.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github-logo" /></a>
      <a class="round" href={`mailto:${site.email}`} aria-label="Email"><Icon name="envelope-simple" /></a>
    </div>
  </div>
</footer>

<style>
  .ftr { position: relative; overflow: hidden; isolation: isolate; padding-top: clamp(72px, 8vw, 120px); }
  .smoke { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .smoke span { position: absolute; border-radius: 50%; will-change: transform; }
  .s1 { width: 70vw; height: 34vw; left: -12vw; bottom: -14vw; background: radial-gradient(closest-side, rgba(206, 0, 55, 0.75), transparent); filter: blur(60px); }
  .s2 { width: 46vw; height: 30vw; left: 30vw; bottom: -18vw; background: radial-gradient(closest-side, rgba(255, 42, 85, 0.5), transparent); filter: blur(70px); }
  .s3 { width: 40vw; height: 24vw; right: -10vw; bottom: -6vw; background: radial-gradient(closest-side, rgba(150, 0, 40, 0.6), transparent); filter: blur(60px); }
  @media (prefers-reduced-motion: no-preference) {
    .s1 { animation: smoke 18s ease-in-out infinite alternate; }
    .s2 { animation: smoke 13s ease-in-out -4s infinite alternate-reverse; }
    .s3 { animation: smoke 21s ease-in-out -9s infinite alternate; }
  }
  @keyframes smoke { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(6vw, -3vw, 0) scale(1.15); } }

  .top { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 48px clamp(32px, 6vw, 96px); align-items: start; }
  .who { display: grid; gap: 22px; justify-items: start; }
  .brand { font-size: 1.42rem; letter-spacing: -0.045em; }
  .brand em, .big em { font-style: italic; }
  .brand em { font-weight: 560; }
  .big { font-size: clamp(2.6rem, 5.2vw, 4.6rem); line-height: 1.06; letter-spacing: -0.045em; color: var(--ink-2); }
  .big em { font-weight: 460; color: #fff; }
  .mail { font-size: clamp(1.3rem, 3vw, 2.8rem); line-height: 1.1; letter-spacing: -0.045em; text-decoration: none; overflow-wrap: anywhere; background: linear-gradient(#fff, #fff) left bottom / 0% 2px no-repeat; padding-bottom: 6px; transition: background-size 0.6s var(--ease); }
  .mail:hover { background-size: 100% 2px; }
  .tag-line { color: var(--muted); max-width: 34ch; }
  .menu { display: grid; }
  .menu a { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 15px 0; border-bottom: 1px solid var(--line-2); text-decoration: none; font-size: 1.06rem; }
  .menu a:first-child { padding-top: 0; }
  .menu :global(.icon) { font-size: 16px; color: var(--muted); transition: transform 0.4s var(--ease), color 0.3s; }
  .menu a:hover :global(.icon) { transform: translateX(4px); color: var(--accent-text); }
  .n { font: 400 var(--mono-xs)/1 var(--mono); color: var(--muted); letter-spacing: 0.06em; }
  .bottom { margin-top: clamp(72px, 9vw, 128px); padding-block: 26px 30px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 18px; border-top: 1px solid var(--line-2); font-size: 0.9rem; color: var(--ink-2); line-height: 1.7; }
  .bottom a { color: #fff; }
  .social { display: flex; gap: 10px; }
  .social .round { color: #fff; background: rgba(11, 10, 10, 0.3); }
  .social .round:hover { background: #fff; color: #0b0a0a; border-color: #fff; }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr; } }
</style>
