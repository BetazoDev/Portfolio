---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { t, type Lang } from "../lib/content";
import agendaImg from "../assets/shots/schedule-d.jpg";
import hemenuImg from "../assets/shots/hemenu-menu-m.jpg";
import abImg from "../assets/shots/demo-ababogadosmty-m.jpg";
import quoteImg from "../assets/shots/simulador-d.jpg";
import steniaImg from "../assets/shots/stenia-m.jpg";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang].work;
const cells = [
  { key: "agenda", img: agendaImg, shape: "wide", alt: "Agenda Hemeron booking page" },
  { key: "hemenu", img: hemenuImg, shape: "phone", alt: "Hemenú public menu on a phone" },
  { key: "ab", img: abImg, shape: "phone", alt: "AB Abogados website on a phone" },
  { key: "quote", img: quoteImg, shape: "wide", alt: "Quote simulator with package options and total" },
  { key: "stenia", img: steniaImg, shape: "phone", alt: "Stenia sign-in screen" },
] as const;
---
<section class="work section" aria-labelledby="work-title">
  <div class="wrap">
    <h2 id="work-title" class="h2" data-reveal>{c.title}</h2>
    <div class="bento">
      {cells.map((cell, i) => {
        const item = c.items[cell.key];
        return (
          <article class:list={["cell", cell.shape, `c-${cell.key}`]} data-reveal data-reveal-delay={String((i % 2) * 0.06)}>
            <div class="media">
              <Picture src={cell.img} alt={cell.alt} widths={cell.shape === "wide" ? [640, 960, 1280] : [320, 480, 640]} sizes={cell.shape === "wide" ? "(max-width: 900px) 92vw, 640px" : "(max-width: 900px) 70vw, 300px"} formats={["avif", "webp"]} loading="lazy" />
            </div>
            <div class="body">
              <h3>{item.name}</h3>
              <p>{item.text}</p>
              <ul class="tags">{item.tags.split(" · ").map((tag) => <li>{tag}</li>)}</ul>
              <a class="link-arrow" href={`https://${item.link}`} target="_blank" rel="noopener">{item.link}<Icon name="arrowUpRight" /></a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .bento { margin-top: clamp(36px, 5vw, 56px); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 20px; }
  .cell { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-2); overflow: hidden; display: grid; }
  .body { padding: clamp(20px, 2.4vw, 28px); display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; align-content: start; }
  .body h3 { font-size: 1.5rem; }
  .body p { color: var(--muted); font-size: 0.98rem; max-width: 56ch; }
  .body .link-arrow { margin-top: 4px; font-size: 0.95rem; overflow-wrap: anywhere; }
  .media { overflow: hidden; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }

  /* Row 1: Agenda (wide) + Hemenú (phone). Row 2: AB (phone) + Quote (wide). Row 3: Stenia across. */
  .c-agenda { grid-column: span 7; }
  .c-hemenu { grid-column: span 5; }
  .c-ab { grid-column: span 5; }
  .c-quote { grid-column: span 7; }
  .c-stenia { grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }

  .wide { grid-template-rows: auto 1fr; }
  .wide .media { aspect-ratio: 16 / 10; border-bottom: 1px solid var(--line); }

  .phone { grid-template-rows: auto 1fr; }
  .phone .media { aspect-ratio: auto; height: clamp(260px, 26vw, 340px); padding: 28px 24px 0; background: var(--panel); border-bottom: 1px solid var(--line); display: flex; justify-content: center; align-items: flex-start; }
  .phone .media :global(picture) { width: min(62%, 230px); }
  .phone .media :global(img) { border-radius: 22px 22px 0 0; border: 1px solid var(--panel-line); border-bottom: 0; height: auto; }
  .c-stenia { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: none; }
  .c-stenia .media { order: 2; height: 100%; min-height: 300px; max-height: 360px; border-bottom: 0; border-left: 1px solid var(--line); }
  .c-stenia .body { align-content: center; }

  @media (max-width: 900px) {
    .c-agenda, .c-hemenu, .c-ab, .c-quote, .c-stenia { grid-column: 1 / -1; }
    .c-stenia { grid-template-columns: 1fr; }
    .c-stenia .media { order: 0; height: 300px; border-left: 0; border-bottom: 1px solid var(--line); }
  }
</style>
