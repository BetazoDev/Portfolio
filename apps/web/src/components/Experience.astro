---
import { t, type Lang } from "../lib/content";
interface Props { lang: Lang }
const c = t[Astro.props.lang].experience;
---
<section id="experience" class="experience section" aria-labelledby="exp-title">
  <div class="wrap layout">
    <div class="intro">
      <h2 id="exp-title" class="h2" data-reveal>{c.title}</h2>
      <p class="edu" data-reveal>{c.education}</p>
    </div>
    <ol class="list">
      {c.items.map((e, i) => (
        <li class:list={{ current: i === 0 }} data-reveal>
          <p class="dates">{e.dates}</p>
          <div>
            <h3>{e.role}</h3>
            <p class="org">{e.org}</p>
            <p class="text">{e.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(32px, 5vw, 72px); }
  .edu { margin-top: 20px; color: var(--muted); max-width: 34ch; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 20px; }
  .dates { font-size: 0.9rem; color: var(--muted); font-variant-numeric: tabular-nums; padding-top: 3px; }
  h3 { font-size: 1.25rem; }
  .current h3::after { content: ""; display: inline-block; width: 8px; height: 8px; margin-left: 10px; border-radius: 50%; background: var(--accent); vertical-align: middle; }
  .org { font-weight: 500; margin-top: 2px; }
  .text { color: var(--muted); font-size: 0.96rem; margin-top: 4px; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { li { grid-template-columns: 1fr; gap: 4px; } }
</style>
