---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Icon from "../Icon.astro";
import Pipeline from "../Pipeline.astro";
import { covers, inline } from "../../lib/images";
import { t, href, type Lang } from "../../lib/content";
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const list = t.projects[lang];
const i = list.findIndex((p) => p.slug === slug);
const p = list[i];
const next = list[(i + 1) % list.length];
const ui = t.ui[lang];
const L = lang === "es"
  ? { role: "Rol", year: "Año", stack: "Stack", links: "Enlaces", how: "Cómo funciona", built: "Construido con", internal: "Herramienta interna" }
  : { role: "Role", year: "Year", stack: "Stack", links: "Links", how: "How it works", built: "Built with", internal: "Internal tool" };
const home = t.home[lang];
---
<Base lang={lang} title={`${p.name} | Humberto Alonso López`} description={p.summary} path={`/work/${p.slug}/`} current="work" image={`/og/${p.slug}${lang === "es" ? "-es" : ""}.png`}>
  <div class="progress" aria-hidden="true"></div>
  <div class="frame">
    <section class="band no-rule top" aria-labelledby="case-title">
      <div class="inner">
        <a class="back" href={href(lang, "/work/")}><Icon name="arrow-left" />{ui.cta.back}</a>
        <p class="eyebrow" data-reveal>{p.tags[0]} / {p.year}</p>
        <h1 id="case-title" class="display" transition:name={`title-${p.slug}`}>{p.name}</h1>
        <p class="tagline" data-reveal>{p.tagline}</p>
      </div>
      <dl class="meta" data-reveal>
        <div><dt>{L.role}</dt><dd>{p.role}</dd></div>
        <div><dt>{L.year}</dt><dd>{p.year}</dd></div>
        <div><dt>{L.stack}</dt><dd>{p.stack.slice(0, 5).join(", ")}</dd></div>
        <div><dt>{L.links}</dt><dd class="links">{p.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}<Icon name="arrow-up-right" /></a>)}</dd></div>
      </dl>
    </section>

    <section class="band cover-band" aria-hidden="true">
      <div class="inner">
        <div class="media cover" transition:name={`cover-${p.slug}`}>
          <Picture src={covers[p.slug]} alt="" widths={[800, 1280, 1600]} sizes="(max-width: 1400px) 94vw, 1300px" formats={["avif", "webp"]} loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="band metrics" aria-label={lang === "es" ? "Cifras" : "Figures"}>
      {p.metrics.map((m, k) => (
        <div class="metric" data-reveal data-reveal-delay={String(k * 0.06)}>
          <p class="value">{m.value}</p>
          <p class="label">{m.label}</p>
        </div>
      ))}
    </section>

    <div class="body">
      {p.sections.map((s, k) => (
        <>
          <section class="band plus chapter">
            <div class="inner chap">
              <h2 class="h3" data-reveal>{s.h}</h2>
              <div class="text">
                {s.p.map((para) => <p data-reveal>{para}</p>)}
                {s.image && inline[s.image] && (
                  <figure class:list={["shot", inline[s.image].kind]} data-reveal>
                    <div class="frame-media"><Picture src={inline[s.image].src} alt={s.caption ?? ""} widths={inline[s.image].kind === "phone" ? [320, 480, 640] : [720, 1100, 1440]} sizes={inline[s.image].kind === "phone" ? "300px" : "(max-width: 900px) 92vw, 820px"} formats={["avif", "webp"]} loading="lazy" /></div>
                    {s.caption && <figcaption>{s.caption}</figcaption>}
                  </figure>
                )}
              </div>
            </div>
          </section>
          {p.slug === "prospector" && k === 1 && (
            <section class="band dark pipe-band" aria-label={L.how}>
              <div class="inner">
                <p class="eyebrow">{L.how}</p>
                <h2 class="h2 pipe-title">{home.pipeTitle} <em>{home.pipeTitleMuted}</em></h2>
                <div class="pipe"><Pipeline lang={lang} /></div>
              </div>
            </section>
          )}
        </>
      ))}
    </div>

    <section class="band plus stack" aria-label={L.built}>
      <div class="inner chap">
        <h2 class="h3">{L.built}</h2>
        <ul class="tags">{p.stack.map((s) => <li class="tag">{s}</li>)}</ul>
      </div>
    </section>

    <a class="band next" href={href(lang, `/work/${next.slug}/`)}>
      <span class="inner nx">
        <span class="nx-copy">
          <span class="eyebrow">{ui.cta.next}</span>
          <span class="h2 nx-name" transition:name={`title-${next.slug}`}>{next.name}</span>
          <span class="nx-tag">{next.tagline}</span>
        </span>
        <span class="media nx-media" transition:name={`cover-${next.slug}`}>
          <Picture src={covers[next.slug]} alt="" widths={[480, 720]} sizes="(max-width: 900px) 92vw, 460px" formats={["avif", "webp"]} loading="lazy" />
        </span>
      </span>
    </a>
  </div>
</Base>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); transform-origin: left; transform: scaleX(0); z-index: 41; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress { animation: grow linear both; animation-timeline: scroll(root); }
    }
  }
  @keyframes grow { to { transform: scaleX(1); } }

  .top { padding-top: clamp(40px, 6vw, 72px); }
  .top .inner { display: grid; gap: 22px; justify-items: start; }
  .back { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--muted); font-size: 0.92rem; margin-bottom: 18px; }
  .back:hover { color: var(--ink); }
  .display { font-size: clamp(2.8rem, 7vw, 6.4rem); }
  .tagline { font-size: clamp(1.2rem, 2vw, 1.65rem); letter-spacing: -0.02em; line-height: 1.3; color: var(--muted); max-width: 40ch; }
  .meta { margin: clamp(40px, 5vw, 64px) 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .meta div { padding: 22px var(--pad) 26px clamp(18px, 2vw, 28px); border-left: 1px solid var(--line); }
  .meta div:first-child { border-left: 0; padding-left: var(--pad); }
  .meta dt { font: 400 var(--mono-xs)/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }
  .meta dd { margin: 10px 0 0; font-size: 0.95rem; }
  .links { display: grid; gap: 6px; }
  .links a { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; border-bottom: 1px solid var(--line); width: fit-content; }
  .links a:hover { border-color: var(--accent); }

  .cover-band { padding-block: 10px; }
  .cover-band .inner { padding-inline: 10px; }
  .cover { aspect-ratio: 16 / 9.2; border-radius: 24px; }

  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--line); margin-top: 24px; }
  .metric { padding: 30px var(--pad) 32px clamp(18px, 2vw, 28px); border-left: 1px solid var(--line); }
  .metric:first-child { border-left: 0; padding-left: var(--pad); }
  .value { font-size: clamp(1.8rem, 3vw, 2.7rem); letter-spacing: -0.045em; line-height: 1; color: #fff; }
  .label { margin-top: 10px; font-size: 0.88rem; color: var(--muted); max-width: 26ch; }

  .chapter { padding-block: clamp(48px, 6vw, 88px); border-top: 1px solid var(--line); }
  .chap { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px clamp(24px, 4vw, 64px); align-items: start; }
  .chap > .h3 { position: sticky; top: 100px; }
  .text { display: grid; gap: 18px; }
  .text p { font-size: 1.08rem; color: color-mix(in srgb, var(--ink) 82%, var(--paper)); max-width: 64ch; }
  .shot { margin: 14px 0 0; }
  .frame-media { border-radius: 18px; overflow: hidden; border: 1px solid var(--line); background: var(--dark); }
  .shot.phone .frame-media { width: min(300px, 70%); border-radius: 30px; border: 8px solid #26211f; }
  figcaption { margin-top: 12px; font: 400 var(--mono-xs)/1.5 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); }

  .pipe-band { padding-block: clamp(64px, 8vw, 112px); border-radius: var(--radius); border: 1px solid var(--line); margin-block: 24px; background: radial-gradient(80% 120% at 0% 0%, rgba(206, 0, 55, 0.16), transparent 60%), var(--dark); }
  .pipe-title { margin-top: 22px; }
  .pipe { margin-top: clamp(48px, 6vw, 72px); }

  .stack { padding-block: clamp(48px, 6vw, 80px); border-top: 1px solid var(--line); }

  .next { border-top: 1px solid var(--line); display: block; text-decoration: none; color: inherit; padding-block: clamp(48px, 6vw, 88px); transition: background-color 0.4s var(--ease); }
  .next:hover { background: color-mix(in srgb, var(--card) 70%, transparent); }
  .nx { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: 32px; align-items: center; }
  .nx-copy { display: grid; gap: 16px; }
  .nx-name { width: fit-content; }
  .nx-tag { color: var(--muted); max-width: 44ch; }
  .nx-media { aspect-ratio: 16 / 10; border: 1px solid var(--line); }
  .nx-media :global(img) { transition: transform 1s var(--ease); }
  .next:hover .nx-media :global(img) { transform: scale(1.04); }

  @media (max-width: 900px) {
    .meta, .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .meta div:nth-child(3), .metric:nth-child(3) { border-left: 0; padding-left: var(--pad); }
    .meta div:nth-child(n + 3), .metric:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .chap, .nx { grid-template-columns: 1fr; }
    .chap > .h3 { position: static; }
  }
  @media (max-width: 520px) {
    .meta, .metrics { grid-template-columns: 1fr; }
    .meta div, .metric { border-left: 0; padding-left: var(--pad); }
    .meta div + div, .metric + .metric { border-top: 1px solid var(--line); }
    .cover { border-radius: 18px; }
  }
</style>
