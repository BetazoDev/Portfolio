---
// The seven stages of the Prospector, as a track on desktop and a vertical line on phones.
import { t, type Lang } from "../lib/content";
interface Props { lang: Lang; tone?: "panel" | "page" }
const { lang, tone = "panel" } = Astro.props;
const steps = t[lang].flagship.steps;
---
<ol class:list={["pipeline", tone]}>
  {steps.map((s, i) => (
    <li data-reveal data-reveal-delay={String(i * 0.05)}>
      <span class="node" aria-hidden="true"></span>
      <h3>{s.name}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .pipeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0 18px; position: relative; }
  .pipeline::before { content: ""; position: absolute; left: 6px; right: 6px; top: 6px; height: 1px; background: var(--rail); }
  li { position: relative; padding-top: 30px; }
  .node { position: absolute; top: 0; left: 0; width: 13px; height: 13px; border-radius: 50%; background: var(--node-bg); border: 2px solid var(--accent); }
  li:last-child .node { background: var(--accent); }
  h3 { font-size: 1.15rem; letter-spacing: -0.01em; }
  p { margin-top: 8px; font-size: 0.9rem; line-height: 1.5; color: var(--step-muted); }

  .panel { --rail: var(--panel-line); --node-bg: var(--panel); --step-muted: var(--panel-muted); }
  .page { --rail: var(--line); --node-bg: var(--bg); --step-muted: var(--muted); }

  @media (max-width: 1023px) {
    .pipeline { grid-template-columns: 1fr; gap: 26px; padding-left: 30px; }
    .pipeline::before { left: 6px; right: auto; top: 8px; bottom: 8px; width: 1px; height: auto; }
    li { padding-top: 0; }
    .node { left: -30px; top: 4px; }
    p { max-width: 52ch; font-size: 0.95rem; }
  }
</style>
