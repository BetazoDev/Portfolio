---
// The Prospector's seven stages on a rail. Markers light up in order (site.ts → pipeline()).
import { t, type Lang } from "../lib/content";
interface Props { lang: Lang }
const steps = t.home[Astro.props.lang].pipeSteps;
---
<ol class="steps" data-steps>
  <span class="rail" aria-hidden="true"><span class="fill" data-rail></span></span>
  {steps.map((s) => (
    <li>
      <span class="node" data-node aria-hidden="true"></span>
      <h3>{s.name}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .rail { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--line); }
  .fill { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  li { position: relative; padding: 34px 20px 8px 0; border-left: 1px solid var(--line); padding-left: 18px; }
  li:first-of-type { border-left: 0; padding-left: 0; }
  .node { position: absolute; top: -6px; left: -6px; width: 11px; height: 11px; border-radius: 50%; border: 1px solid var(--faint); background: var(--dark); transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease); }
  li:first-of-type .node { left: 0; }
  .node:global(.lit) { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 5px rgba(206, 0, 55, 0.22); }
  h3 { font-size: 1.2rem; letter-spacing: -0.025em; }
  p { margin-top: 10px; font-size: 0.88rem; color: var(--muted); line-height: 1.5; }
  @media (max-width: 1100px) {
    .steps { grid-template-columns: 1fr; padding-left: 26px; gap: 26px; }
    .rail { left: 5px; right: auto; top: 6px; bottom: 6px; width: 1px; height: auto; }
    .fill { transform-origin: top; }
    li, li:first-of-type { border-left: 0; padding: 0; }
    .node, li:first-of-type .node { left: -26px; top: 6px; }
    p { max-width: 52ch; }
  }
</style>
