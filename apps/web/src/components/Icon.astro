---
// Phosphor icons (regular), inlined so they take currentColor.
// Regular weight by name ("arrow-right"); the filled set by its own name ("check-circle-fill").
const files = {
  ...import.meta.glob("../../node_modules/@phosphor-icons/core/assets/regular/*.svg", { query: "?raw", import: "default", eager: true }),
  ...import.meta.glob("../../node_modules/@phosphor-icons/core/assets/fill/{check-circle-fill,star-four-fill}.svg", { query: "?raw", import: "default", eager: true }),
} as Record<string, string>;
const byName: Record<string, string> = {};
for (const [p, svg] of Object.entries(files)) byName[p.split("/").pop()!.replace(".svg", "")] = svg;

interface Props { name: string; label?: string; class?: string }
const { name, label, class: cls } = Astro.props;
const raw = byName[name];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw.replace("<svg", `<svg aria-hidden="true" focusable="false"`);
---
<span class:list={["icon", cls]} role={label ? "img" : undefined} aria-label={label}><Fragment set:html={svg} /></span>
