---
import Icon from "./Icon.astro";
import { t, site, type Lang } from "../lib/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang].contact;
const files = [
  { label: c.cvEn, href: site.cv.en.pdf, kind: c.pdf },
  { label: c.cvEn, href: site.cv.en.docx, kind: c.docx },
  { label: c.cvEs, href: site.cv.es.pdf, kind: c.pdf },
  { label: c.cvEs, href: site.cv.es.docx, kind: c.docx },
];
---
<section id="contact" class="contact section" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title" class="title" data-reveal>{c.title}</h2>
    <p class="lead" data-reveal>{c.text}</p>
    <a class="mail" href={`mailto:${site.email}`} data-reveal>
      <Icon name="envelope" />{site.email}
    </a>
    <div class="rows">
      <ul class="links" data-reveal>
        <li><a class="link-arrow" href={site.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn<Icon name="arrowUpRight" /></a></li>
        <li><a class="link-arrow" href={site.github} target="_blank" rel="noopener"><Icon name="github" />GitHub<Icon name="arrowUpRight" /></a></li>
        <li><a class="link-arrow" href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a></li>
      </ul>
      <ul class="files" data-reveal>
        {files.map((f) => (
          <li><a href={f.href} download><span>{f.label}</span><span class="kind">{f.kind}</span><Icon name="download" /></a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact { border-top: 1px solid var(--line); }
  .title { font-size: clamp(2.4rem, 6vw, 5rem); max-width: 14ch; }
  .lead { margin-top: 20px; }
  .mail {
    margin-top: 36px; display: inline-flex; align-items: center; gap: 14px;
    font: 600 clamp(1.25rem, 3.2vw, 2.25rem)/1.1 var(--display); letter-spacing: -0.01em;
    text-decoration: none; color: var(--accent); word-break: break-all;
    border-bottom: 2px solid currentColor; padding-bottom: 6px;
  }
  .mail:hover { color: var(--accent-hover); }
  .rows { margin-top: 48px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  ul { list-style: none; margin: 0; padding: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .links .icon { font-size: 1.1rem; }
  .files { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .files a { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-size: 0.95rem; transition: border-color 0.2s var(--ease); }
  .files a:hover { border-color: var(--ink); }
  .files .kind { margin-left: auto; color: var(--muted); font-size: 0.8rem; font-weight: 500; }
  @media (max-width: 900px) { .rows { grid-template-columns: 1fr; } }
  @media (max-width: 460px) { .files { grid-template-columns: 1fr; } }
</style>
