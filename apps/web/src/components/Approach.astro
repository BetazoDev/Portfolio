---
import { t, type Lang } from "../lib/content";
interface Props { lang: Lang }
const c = t[Astro.props.lang].approach;
---
<section id="approach" class="approach section" aria-labelledby="approach-title">
  <div class="wrap layout">
    <h2 id="approach-title" class="h2" data-reveal>{c.title}</h2>
    <div class="grid">
      {c.items.map((it, i) => (
        <article data-reveal data-reveal-delay={String((i % 2) * 0.06)}>
          <h3>{it.name}</h3>
          <p>{it.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .approach { background: var(--bg-2); }
  .layout { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .layout > h2 { position: sticky; top: 104px; max-width: 12ch; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 4vw, 48px) clamp(24px, 3vw, 40px); }
  article { border-top: 2px solid var(--accent); padding-top: 20px; }
  h3 { font-size: 1.35rem; }
  p { margin-top: 10px; color: var(--muted); }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .layout > h2 { position: static; max-width: none; }
  }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
