---
import Icon from "./Icon.astro";
import Roll from "./Roll.astro";
import { t, href, site, type Lang } from "../lib/content";
interface Props { lang: Lang; alt: string; current: "home" | "work" | "about" | "contact" | "none" }
const { lang, alt, current } = Astro.props;
const c = t.ui[lang].nav;
const talk = t.home[lang].build.cta;
const links = [
  { key: "work", label: c.work, url: href(lang, "/work/") },
  { key: "about", label: c.about, url: href(lang, "/about/") },
  { key: "contact", label: c.contact, url: href(lang, "/contact/") },
];
---
<header class="hdr" transition:name="site-header" transition:animate="none" data-menu-root data-hdr>
  <div class="row">
    <a class="brand" href={href(lang, "/")} aria-label={site.name}><em>Humberto</em> Alonso</a>
    <nav class="links" aria-label={lang === "es" ? "Principal" : "Main"}>
      {links.map((l) => (
        <a href={l.url} aria-current={current === l.key ? "page" : undefined} aria-label={l.label}><Roll text={l.label} /></a>
      ))}
      <a class="lang" href={alt} hreflang={lang === "es" ? "en" : "es"} lang={lang === "es" ? "en" : "es"} aria-label={c.otherName}><Roll text={c.other} /></a>
    </nav>
    <div class="end">
      <a class="btn btn-accent cta" href={href(lang, "/contact/")} aria-label={talk}><Roll text={talk} /><Icon name="arrow-up-right" /></a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden">{c.menu}</span><span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="sheet" data-menu-sheet hidden>
    <nav class="sheet-links" aria-label={c.menu}>
      {[{ key: "home", label: t.home[lang].end.home, url: href(lang, "/") }, ...links].map((l, i) => (
        <a href={l.url} aria-current={current === l.key ? "page" : undefined}><span>{l.label}</span><span class="n" aria-hidden="true">0{i + 1}</span></a>
      ))}
    </nav>
    <div class="sheet-end">
      <a class="btn btn-light dl" href={site.cv[lang].pdf} download data-astro-reload aria-label={c.cv}><Roll text={c.cv} /><Icon name="download-simple" /></a>
      <a class="btn btn-line" href={alt} hreflang={lang === "es" ? "en" : "es"} lang={lang === "es" ? "en" : "es"} aria-label={c.otherName}><Roll text={c.otherName} /></a>
    </div>
  </div>
</header>

<style>
  .hdr { position: fixed; top: 0; left: 0; right: 0; z-index: 40; color: #fff; transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease); border-bottom: 1px solid transparent; }
  .hdr[data-scrolled] { background: rgba(11, 10, 10, 0.72); -webkit-backdrop-filter: blur(16px) saturate(1.2); backdrop-filter: blur(16px) saturate(1.2); border-bottom-color: var(--line); }
  .hdr[data-open] { background: var(--paper); }
  .row { max-width: calc(var(--wrap) + 2 * var(--pad)); margin-inline: auto; height: var(--hdr); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding-inline: var(--pad); }
  .brand { text-decoration: none; font-size: 1.42rem; letter-spacing: -0.045em; white-space: nowrap; justify-self: start; }
  .brand em { font-style: italic; font-weight: 560; letter-spacing: -0.05em; }
  .links { display: flex; align-items: center; gap: 34px; }
  .links a { text-decoration: none; font-size: 1rem; color: var(--ink-2); position: relative; padding-block: 6px; transition: color 0.2s; }
  .links a:hover, .links a[aria-current="page"] { color: #fff; }
  .links a[aria-current="page"]::after { content: ""; position: absolute; left: 50%; bottom: -4px; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: var(--accent-text); }
  .links .lang { font: 400 var(--mono-s)/1 var(--mono); letter-spacing: 0.08em; padding: 8px 10px; border-radius: 999px; border: 1px solid var(--line-2); }
  .links .lang .roll { height: 1.3em; line-height: 1.3; }
  .end { display: flex; align-items: center; justify-content: flex-end; gap: 12px; }
  .cta { height: 50px; padding-inline: 22px; }
  .burger { display: none; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line-2); background: transparent; color: #fff; align-items: center; justify-content: center; cursor: pointer; }
  .bars { position: relative; width: 18px; height: 10px; display: block; }
  .bars i { position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; border-radius: 2px; transition: transform 0.4s var(--ease), top 0.4s var(--ease); }
  .bars i:first-child { top: 0; }
  .bars i:last-child { top: 8.5px; }
  [data-open] .bars i:first-child { top: 4.25px; transform: rotate(45deg); }
  [data-open] .bars i:last-child { top: 4.25px; transform: rotate(-45deg); }
  .sheet[hidden] { display: none; }
  .sheet { height: calc(100dvh - var(--hdr)); overflow-y: auto; padding: 12px var(--pad) 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: var(--paper); }
  .sheet-links { display: grid; }
  .sheet-links a { display: flex; justify-content: space-between; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 2.2rem; letter-spacing: -0.045em; line-height: 1.1; }
  .sheet-links a[aria-current="page"] span:first-child { font-style: italic; color: #fff; }
  .n { font: 400 var(--mono-s)/1 var(--mono); color: var(--faint); letter-spacing: 0.06em; }
  .sheet-end { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr auto; }
    .links, .cta { display: none; }
    .burger { display: inline-flex; }
  }
  @media (min-width: 861px) { .sheet { display: none !important; } }
</style>
