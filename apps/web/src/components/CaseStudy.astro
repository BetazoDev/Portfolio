---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Pipeline from "./Pipeline.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import { t, path, type Lang } from "../lib/content";
import quoteImg from "../assets/shots/simulador-d.jpg";
import nebula from "../assets/shots/demo-nebulastudio-d.jpg";
import creative from "../assets/shots/demo-creativeartmedia-d.jpg";
import ab from "../assets/shots/demo-ababogadosmty-d.jpg";
import vidriera from "../assets/shots/demo-vidrieraroman-d.jpg";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang].cs;
const alt = lang === "es" ? "/work/prospector/" : "/es/work/prospector/";
const gallery = [
  { src: nebula, alt: "Nebula Studio" },
  { src: creative, alt: "Creative Art Media" },
  { src: ab, alt: "AB Abogados" },
  { src: vidriera, alt: "Vidriera Román" },
];
// Sections 0-1 before the pipeline, 2-4 after it, gallery, then results.
const before = c.sections.slice(0, 2);
const middle = c.sections.slice(2, 5);
const results = c.sections[5];
---
<Base lang={lang} title={c.metaTitle} description={c.metaDescription} path="/work/prospector/">
  <Nav lang={lang} alt={alt} />
  <main id="main">
    <header class="wrap top">
      <a class="link-arrow back" href={path(lang, "/")}><Icon name="arrowLeft" />{c.back}</a>
      <h1 class="title">{c.title}</h1>
      <p class="lead">{c.lead}</p>
      <dl class="facts">
        {c.facts.map((f) => (<div><dt>{f.k}</dt><dd>{f.v}</dd></div>))}
      </dl>
    </header>

    <div class="wrap prose">
      {before.map((s) => (
        <section data-reveal><h2>{s.h}</h2>{s.p.map((p) => <p>{p}</p>)}</section>
      ))}
    </div>

    <section class="diagram" aria-labelledby="pipe-title">
      <div class="wrap">
        <h2 id="pipe-title" class="h2">{c.pipelineTitle}</h2>
        <div class="pipe"><Pipeline lang={lang} tone="panel" /></div>
      </div>
    </section>

    <div class="wrap prose">
      {middle.map((s, i) => (
        <section data-reveal>
          <h2>{s.h}</h2>
          {s.p.map((p) => <p>{p}</p>)}
          {i === 1 && (
            <figure class="shot">
              <Picture src={quoteImg} alt={lang === "es" ? "Simulador de cotización con paquetes y total" : "Quote simulator with packages and total"} widths={[720, 1100, 1440]} sizes="(max-width: 900px) 92vw, 760px" formats={["avif", "webp"]} loading="lazy" />
              <figcaption>brief.hemeron.com/simulador</figcaption>
            </figure>
          )}
        </section>
      ))}
    </div>

    <section class="wrap gallery" aria-labelledby="gal-title">
      <h2 id="gal-title">{c.galleryTitle}</h2>
      <div class="grid">
        {gallery.map((g) => (
          <div class="frame"><Picture src={g.src} alt={g.alt} widths={[560, 840]} sizes="(max-width: 700px) 92vw, 560px" formats={["avif", "webp"]} loading="lazy" /></div>
        ))}
      </div>
    </section>

    <div class="wrap prose">
      <section data-reveal><h2>{results.h}</h2>{results.p.map((p) => <p>{p}</p>)}</section>
    </div>

    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .top { padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(40px, 6vw, 64px); display: grid; gap: 20px; }
  .back { font-size: 0.95rem; color: var(--muted); }
  .back:hover { color: var(--ink); }
  .title { font-size: clamp(2.6rem, 6.4vw, 5.25rem); margin-top: 12px; }
  .facts { margin: 24px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; border-top: 1px solid var(--line); padding-top: 24px; }
  .facts dt { font-size: 0.85rem; color: var(--muted); }
  .facts dd { margin: 4px 0 0; font-weight: 500; }

  .prose { display: grid; gap: clamp(40px, 5vw, 64px); padding-block: clamp(32px, 5vw, 56px); }
  .prose section { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: clamp(24px, 4vw, 64px); row-gap: 16px; }
  .prose h2 { grid-column: 1; grid-row: 1 / span 8; font-size: clamp(1.5rem, 2.4vw, 2rem); align-self: start; }
  .prose p { grid-column: 2; font-size: 1.08rem; max-width: 66ch; }

  .diagram { background: var(--panel); color: var(--panel-ink); padding-block: clamp(56px, 8vw, 96px); margin-block: clamp(24px, 4vw, 48px); }
  .pipe { margin-top: clamp(36px, 5vw, 56px); }

  .shot { grid-column: 2; margin: 12px 0 0; }
  .shot :global(img) { border-radius: var(--radius); border: 1px solid var(--line); }
  .shot figcaption { margin-top: 10px; font-size: 0.88rem; color: var(--muted); }

  .gallery { padding-block: clamp(24px, 4vw, 48px); }
  .gallery h2 { font-size: clamp(1.5rem, 2.4vw, 2rem); margin-bottom: 24px; }
  .gallery .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .gallery .frame { aspect-ratio: 16 / 10; }

  @media (max-width: 900px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .prose section { grid-template-columns: 1fr; }
    .prose h2, .prose p, .shot { grid-column: 1; grid-row: auto; }
  }
  @media (max-width: 600px) { .gallery .grid { grid-template-columns: 1fr; } }
</style>
