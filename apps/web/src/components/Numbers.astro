---
import { t, type Lang } from "../lib/content";
interface Props { lang: Lang }
const items = t[Astro.props.lang].numbers;
---
<section class="numbers" aria-label={Astro.props.lang === "es" ? "Cifras" : "Figures"}>
  <div class="wrap grid">
    {items.map((n, i) => (
      <div class="item" data-reveal data-reveal-delay={String(i * 0.06)}>
        <p class="value">{n.value}</p>
        <p class="label">{n.label}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .numbers { border-block: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .item { padding: clamp(28px, 4vw, 44px) clamp(16px, 2vw, 28px); border-left: 1px solid var(--line); }
  .item:first-child { border-left: 0; padding-left: 0; }
  .value { font: 600 clamp(2.4rem, 4.4vw, 3.6rem)/1 var(--display); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .label { margin-top: 12px; font-size: 0.95rem; color: var(--muted); max-width: 26ch; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .item:nth-child(3) { border-left: 0; padding-left: 0; }
    .item:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
    .item { border-left: 0; padding-left: 0; }
    .item + .item { border-top: 1px solid var(--line); }
  }
</style>
