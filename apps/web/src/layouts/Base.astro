---
import "@fontsource-variable/host-grotesk";
import "@fontsource-variable/host-grotesk/wght-italic.css";
import "@fontsource-variable/martian-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t, site, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // path without the /es prefix, e.g. "/" or "/work/agenda/"
  current?: "home" | "work" | "about" | "contact" | "none";
  image?: string; // absolute path of a share image
  footerContact?: boolean; // the big "Let's talk" block above the footer
}
// Share images live under /og/ (one per page and language) so a new design gets new URLs that previews re-read.
const { lang, title, description, path, current = "none", image = `/og/home${lang === "es" ? "-es" : ""}.png`, footerContact = true } = Astro.props;
const enUrl = new URL(path, site.url).href;
const esUrl = new URL(`/es${path}`, site.url).href;
const canonical = lang === "es" ? esUrl : enUrl;
const alt = lang === "es" ? path : `/es${path}`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.short,
  jobTitle: "AI Engineer",
  url: site.url,
  email: `mailto:${site.email}`,
  image: new URL("/og/home.png", site.url).href,
  address: { "@type": "PostalAddress", addressLocality: "Aguascalientes", addressCountry: "MX" },
  worksFor: { "@type": "Organization", name: "Hemeron", url: "https://hemeron.com" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Universidad Tecnológica El Retoño" },
  knowsAbout: ["Large language models", "AI agents", "Claude API", "Claude Agent SDK", "Model Context Protocol", "Retrieval-augmented generation", "LLM evaluation", "TypeScript", "Next.js", "PostgreSQL", "Go"],
  knowsLanguage: ["es", "en"],
  sameAs: [site.linkedin, site.github],
};

// Page change: the old page lifts away, the new one rises in.
const page = {
  forwards: {
    old: { name: "vt-out", duration: "0.28s", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "vt-in", duration: "0.6s", easing: "cubic-bezier(0.16, 1, 0.3, 1)", delay: "0.06s", fillMode: "both" },
  },
  backwards: {
    old: { name: "vt-out", duration: "0.28s", easing: "cubic-bezier(0.4, 0, 1, 1)", fillMode: "both" },
    new: { name: "vt-in", duration: "0.6s", easing: "cubic-bezier(0.16, 1, 0.3, 1)", delay: "0.06s", fillMode: "both" },
  },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta name="theme-color" content="#0b0a0a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      document.documentElement.classList.add("js");
      setTimeout(function () { if (!window.__site) document.documentElement.classList.remove("js", "intro"); }, 3000);
      // First visit in this tab: crimson columns lift away before the page shows (skipped with reduced motion).
      try {
        if (!sessionStorage.getItem("seen") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("intro");
        sessionStorage.setItem("seen", "1");
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="preloader" aria-hidden="true">{[0, 1, 2, 3, 4].map((i) => <span style={`--i:${i}`}></span>)}</div>
    <a class="skip" href="#main">{t.ui[lang].skip}</a>
    <Header lang={lang} alt={alt} current={current} />
    <main id="main" transition:animate={page}>
      <slot />
    </main>
    <Footer lang={lang} alt={alt} contact={footerContact} />
    <script>
      import { boot } from "../scripts/site";
      boot();
    </script>
    <style is:global>
      .skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: #fff; color: #141211; padding: 10px 14px; border-radius: 999px; text-decoration: none; }
      .skip:focus { top: 12px; }
      .preloader { display: none; }
      html.intro .preloader { display: grid; position: fixed; inset: 0; z-index: 100; grid-template-columns: repeat(5, 1fr); pointer-events: none; }
      html.intro .preloader span { background: #ce0037; border-left: 1px solid rgba(255, 255, 255, 0.14); animation: lift 0.9s cubic-bezier(0.76, 0, 0.24, 1) calc(0.25s + var(--i) * 0.07s) forwards; }
      @keyframes lift { to { transform: translateY(-101%); } }
      @keyframes vt-out { to { opacity: 0; transform: translateY(-14px); } }
      @keyframes vt-in { from { opacity: 0; transform: translateY(26px); } }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
      }
    </style>
  </body>
</html>
