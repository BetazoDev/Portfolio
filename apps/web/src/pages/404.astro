---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---
<Base lang="en" title="Not found | Humberto Alonso López" description="This page does not exist." path="/404/">
  <div class="frame">
    <section class="band no-rule nf">
      <div class="inner">
        <p class="eyebrow">404</p>
        <h1 class="display">This page does not exist.<span class="muted-line">Esta página no existe.</span></h1>
        <div class="b"><Button href="/" label="halonso.digital" variant="light" icon="arrow-right" /><Button href="/es/" label="Español" variant="line" icon="arrow-right" /></div>
      </div>
    </section>
  </div>
</Base>
<style>
  .nf { padding-block: clamp(96px, 14vw, 180px); }
  .nf .inner { display: grid; gap: 26px; justify-items: start; }
  .b { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
