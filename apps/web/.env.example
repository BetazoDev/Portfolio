# Public origin of the site. Used for canonical URLs, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API origin the browser is told about. Client code normally calls the same-origin
# `/api/*` proxy instead, so this only matters for tooling and debugging.
NEXT_PUBLIC_API_URL=http://localhost:4000

# API origin used by server components and by the `/api/*` rewrite. Point this at the
# internal service address in production so renders skip the public DNS + TLS hop.
API_INTERNAL_URL=http://localhost:4000

# Host that serves uploaded media. Must be allow-listed for next/image optimisation.
NEXT_PUBLIC_STORAGE_HOST=supastorage.halonso.digital
